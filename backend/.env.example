APP_PORT=8080
APP_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_NAME=pomelo
DB_USER=root
DB_PASSWORD=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
SESSION_TTL=604800

CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO
LOG_FORMAT=text

DOCS_ROOT=../../storage

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT=900
DEEPSEEK_CONNECT_TIMEOUT=5

AI_MAX_TOKENS=16384
AI_QB_MAX_TOKENS=256000
AI_STUDY_MAX_TOKENS=256000
AI_JSON_MODE=true
AI_DOC_MAX_CHARS=5000
AI_TOTAL_MAX_CHARS=40000
AI_TEMPERATURE=0.7

PROMPTS_FILE=config/prompts.yaml

TTS_DEFAULT_VOICE=zh-CN-XiaoxiaoNeural
TTS_AVAILABLE_VOICES=zh-CN-XiaoxiaoNeural,zh-CN-YunxiNeural,zh-CN-YunjianNeural,zh-CN-XiaoyiNeural,zh-CN-YunyangNeural
TTS_FALLBACK_CHARS_PER_SEC=4.5

OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=pomelo-video
OSS_ENDPOINT_INTERNAL=oss-cn-shanghai-internal.aliyuncs.com
OSS_ENDPOINT_PUBLIC=oss-cn-shanghai.aliyuncs.com
OSS_VIDEO_PREFIX=videos/
